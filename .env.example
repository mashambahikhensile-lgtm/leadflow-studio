PORT=3000
NODE_ENV=development
ADMIN_USER=demo
# Change this before exposing the dashboard publicly. Use a long random value.
ADMIN_PASSWORD=change-this-to-a-long-unique-password
# Optional: HTTPS webhook endpoint from a system you control (e.g. n8n/Make).
# Leave blank to keep the app self-contained.
LEAD_WEBHOOK_URL=
# Path for local JSON persistence. On some hosts, filesystem storage is ephemeral.
DATA_FILE=./data/leads.json
